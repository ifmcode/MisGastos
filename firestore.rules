rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWalletOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    // Profiles keep the Firebase uid in the `uid` field and are looked up by
    // it. Only the owner can read or update the document, and the uid cannot
    // be reassigned after creation.
    match /users/{userId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
    }

    match /wallets/{walletId} {
      allow read, delete: if isWalletOwner(resource.data);

      allow create: if isWalletOwner(request.resource.data);

      allow update: if isWalletOwner(resource.data)
        && isWalletOwner(request.resource.data);
    }

    match /transactions/{transactionId} {
      allow read: if isWalletOwner(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isWalletOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId;

      allow delete: if isWalletOwner(resource.data);
    }

    // User-defined categories. The type is fixed after creation so historical
    // transaction/category type pairs stay consistent.
    match /categories/{categoryId} {
      allow read: if isWalletOwner(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isWalletOwner(resource.data)
        && isWalletOwner(request.resource.data)
        && request.resource.data.type == resource.data.type;

      allow delete: if isWalletOwner(resource.data);
    }

    // Transfers support edit and soft delete. Documents are never hard-deleted:
    // deletedAt marks a transfer whose balances were already reverted.
    match /transfers/{transferId} {
      allow read: if isWalletOwner(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isWalletOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
