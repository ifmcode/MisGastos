rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWalletOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    // The current auth flow creates user documents with an auto-generated id
    // and stores the Firebase uid in the `uid` field.
    match /users/{userId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read, update, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /wallets/{walletId} {
      allow read, delete: if isWalletOwner(resource.data);

      allow create: if isWalletOwner(request.resource.data);

      allow update: if isWalletOwner(resource.data)
        && isWalletOwner(request.resource.data);
    }
  }
}
