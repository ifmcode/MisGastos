rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isWalletOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    // Friend pairs use a deterministic id: both uids sorted lexicographically
    // and joined with "__". Every request and friendship of a pair lives in that
    // single document, so no lookup query or composite index is required.
    function hasSortedPair(memberIds) {
      return memberIds is list
        && memberIds.size() == 2
        && memberIds[0] < memberIds[1];
    }

    function pairIdMatches(documentId, memberIds) {
      return documentId == memberIds[0] + '__' + memberIds[1];
    }

    function isRequestParticipant(data) {
      return isSignedIn() && request.auth.uid in data.participantIds;
    }

    function isFriendMember(data) {
      return isSignedIn() && request.auth.uid in data.memberIds;
    }

    // The public profile email is not client-claimed: it must match the ID
    // token claim, so nobody can publish someone else's address.
    function isOwnTokenEmail(data) {
      return request.auth.token.email != null
        && data.email is string
        && data.email == request.auth.token.email.lower();
    }

    // Bounded by FRIEND_DISPLAY_NAME_MAX_LENGTH (50) in the public profile
    // schema, so a client cannot publish an oversized display name.
    function isDisplayNameValue(value) {
      return value == null || (value is string && value.size() <= 50);
    }

    // The accept batch creates the friendship while the request still exists, so
    // this validates the incoming friendship against the pre-batch request.
    function requestMatchesAcceptance(data, memberIds) {
      return data.status == 'pending'
        && data.recipientId == request.auth.uid
        && data.participantIds == memberIds;
    }

    // Shared expenses are 1:1 records between two accepted friends. Rules cannot
    // sum list values, so the "shares sum to amountCents" invariant stays in the
    // expense schema; rules only check the shape of every stored value.
    function isExpenseParticipant(data) {
      return isSignedIn() && request.auth.uid in data.participantIds;
    }

    function isExpenseShareRow(row) {
      return row is map
        && row.keys().hasOnly(['userId', 'shareCents', 'percentageBps', 'weight'])
        && row.userId is string
        && row.shareCents is int
        && row.shareCents >= 0
        && row.shareCents <= 100000000;
    }

    function hasExpenseShares(data) {
      return data.participants is list
        && data.participants.size() == 2
        && isExpenseShareRow(data.participants[0])
        && isExpenseShareRow(data.participants[1])
        && data.participants[0].userId in data.participantIds
        && data.participants[1].userId in data.participantIds;
    }

    // Bounded by SHARED_EXPENSE_AMOUNT_MAX (1,000,000.00) and
    // SHARED_EXPENSE_DESCRIPTION_MAX_LENGTH (120) in the expense schema.
    function hasExpenseMoney(data) {
      return data.amountCents is int
        && data.amountCents > 0
        && data.amountCents <= 100000000
        && data.splitMode in ['equal', 'percentage', 'fixed', 'shares']
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 120
        && data.date is string;
    }

    function hasExpensePair(data) {
      return hasSortedPair(data.participantIds)
        && data.pairId == data.participantIds[0] + '__' + data.participantIds[1]
        && data.payerId in data.participantIds
        && request.auth.uid in data.participantIds;
    }

    // `null` on an edit, an ISO string on a soft delete: never anything else.
    function isExpenseDeletedAt(value) {
      return value == null || value is string;
    }

    // Optional link keys are bounded ids: absent, null or a non-empty string.
    function isOptionalExpenseId(value) {
      return value == null
        || (value is string && value.size() > 0 && value.size() <= 1500);
    }

    // Legacy documents may omit the keys entirely, so presence is guarded
    // before reading them (a missing map key is an evaluation error).
    function hasExpenseLinks(data) {
      return (!('walletId' in data) || isOptionalExpenseId(data.walletId))
        && (!('categoryId' in data) || isOptionalExpenseId(data.categoryId))
        && (!('linkedTransactionId' in data)
            || isOptionalExpenseId(data.linkedTransactionId));
    }

    // TICKET-055 replaced TICKET-048's mandatory payer wallet: a viewer-paid
    // expense may now be social-only. A link is all-or-nothing, so a wallet and
    // its category exist together (`walletId != null` <=> `categoryId != null`)
    // and a movement cannot outlive the wallet that backs it (TICKET-051 keeps
    // the category mandatory for a link). Legacy documents may omit the keys,
    // so `get` reads a missing one as null. Mirrored by the service guard
    // (`LINK_WITHOUT_REGISTRATION` / `CATEGORY_REQUIRED`) and by the form toggle.
    // Deployment of this file is manual.
    function hasExpenseLinkCoherence(data) {
      return data.get('walletId', null) == null
        ? data.get('categoryId', null) == null
          && data.get('linkedTransactionId', null) == null
        : data.get('categoryId', null) != null;
    }

    // TICKET-069 mirrors the 1:1 link on a group expense: only the payer links
    // one of their own wallets, and the movement is a personal mirror that never
    // changes the group ledger. Same all-or-nothing shape as the pair above.
    function hasGroupExpenseLinks(data) {
      return (!('walletId' in data) || isOptionalExpenseId(data.walletId))
        && (!('categoryId' in data) || isOptionalExpenseId(data.categoryId))
        && (!('linkedTransactionId' in data)
            || isOptionalExpenseId(data.linkedTransactionId));
    }

    function hasGroupExpenseLinkCoherence(data) {
      return data.get('walletId', null) == null
        ? data.get('categoryId', null) == null
          && data.get('linkedTransactionId', null) == null
        : data.get('categoryId', null) != null;
    }

    // The unlinked soft delete touches nothing but the deletion stamps, so an
    // expense can be closed without rewriting the link. The linked delete may
    // also clear `linkedTransactionId` and passes through
    // `hasExpenseLinkCoherence` instead, which keeps a movement id from
    // surviving without the wallet that backs it. Any other write (amount,
    // payer, wallet, category, shares) keeps the full invariant: `diff` allows
    // only the two keys the unlinked repository update writes.
    function isExpenseSoftDelete(previous, next) {
      return previous.deletedAt == null
        && next.deletedAt is string
        && next.diff(previous).affectedKeys().hasOnly(['deletedAt', 'updatedAt']);
    }

    function hasExpenseFields(data) {
      return data.keys().hasOnly(
        [
          'participantIds',
          'pairId',
          'payerId',
          'amountCents',
          'currency',
          'splitMode',
          'participants',
          'description',
          'date',
          'walletId',
          'categoryId',
          'linkedTransactionId',
          'createdBy',
          'createdAt',
          'updatedAt',
          'deletedAt'
        ]
      );
    }

    // A linked movement must be an expense of the payer, between participants of
    // the same currency. `getAfter` is required because the movement and its
    // expense are written in the same transaction: `get` would read the
    // pre-transaction state, where the new expense does not exist yet.
    function hasValidSharedExpenseLink(data) {
      return data.type == 'expense'
        && data.sharedExpenseId is string
        && data.sharedExpenseId.size() > 0
        && isSharedExpenseLinkTarget(
             getAfter(
               /databases/$(database)/documents/sharedExpenses/$(data.sharedExpenseId)
             ).data,
             data
           );
    }

    function isSharedExpenseLinkTarget(expense, data) {
      return expense.participantIds is list
        && request.auth.uid in expense.participantIds
        && expense.payerId == request.auth.uid
        && expense.currency == data.currency;
    }

    // The link may be absent, but it can never be added, removed or retargeted.
    function keepsSharedExpenseLink(previous, next) {
      return ('sharedExpenseId' in previous) == ('sharedExpenseId' in next)
        && (
          !('sharedExpenseId' in previous)
          || previous.sharedExpenseId == next.sharedExpenseId
        );
    }

    // A group-expense movement is an expense of the payer with the same currency
    // as the referenced expense, which must not be deleted. `getAfter` covers the
    // same-transaction create: `get` would not see the new expense yet. Rules
    // cannot compare the movement id or the wallet with the expense fields, so
    // the pair stays proven by the operation and by the expense's own link keys.
    function hasValidGroupExpenseLink(data) {
      return data.type == 'expense'
        && data.groupExpenseId is string
        && data.groupExpenseId.size() > 0
        && isGroupExpenseLinkTarget(
             getAfter(
               /databases/$(database)/documents/groupExpenses/$(data.groupExpenseId)
             ).data,
             data
           );
    }

    function isGroupExpenseLinkTarget(expense, movement) {
      return expense.payerId == request.auth.uid
        && expense.currency == movement.currency
        && expense.get('deletedAt', null) == null;
    }

    // `groupExpenseId` is immutable and can never be swapped for another link.
    function keepsGroupExpenseLink(previous, next) {
      return ('groupExpenseId' in previous) == ('groupExpenseId' in next)
        && (
          !('groupExpenseId' in previous)
          || previous.groupExpenseId == next.groupExpenseId
        );
    }

    // ---- TICKET-046 settlements ------------------------------------------
    // A settlement cancels debt and is applied by existing: no pending state,
    // and a soft-deleted record never counts. Rules cannot sum the pair ledger,
    // so the debt bound stays in the service; here only the shape, the pair and
    // the receiver-only link are validated.
    function isSettlementParticipant(data) {
      return isSignedIn() && request.auth.uid in data.participantIds;
    }

    function isSettlementIdValue(value) {
      return value is string && value.size() > 0 && value.size() <= 1500;
    }

    function isReceiverLinkEmpty(data) {
      return data.receiverWalletId == null
        && data.receiverCategoryId == null
        && data.receiverTransactionId == null;
    }

    function isReceiverLinkComplete(data) {
      return isSettlementIdValue(data.receiverWalletId)
        && isSettlementIdValue(data.receiverCategoryId)
        && isSettlementIdValue(data.receiverTransactionId);
    }

    // Never a partial link: an income without its wallet or category could not be
    // reverted by anyone.
    function hasSettlementLinkShape(data) {
      return isReceiverLinkEmpty(data) || isReceiverLinkComplete(data);
    }

    // Bounded by SETTLEMENT_AMOUNT_MAX (1,000,000.00) and
    // SETTLEMENT_NOTE_MAX_LENGTH (500) in the settlement schema.
    function hasSettlementMoney(data) {
      return data.amountCents is int
        && data.amountCents > 0
        && data.amountCents <= 100000000
        && data.currency is string
        && data.currency.size() > 0
        && data.date is string
        && data.note is string
        && data.note.size() <= 500;
    }

    function hasSettlementPair(data) {
      return hasSortedPair(data.participantIds)
        && data.pairId == data.participantIds[0] + '__' + data.participantIds[1]
        && data.fromUserId in data.participantIds
        && data.toUserId in data.participantIds
        && data.fromUserId != data.toUserId
        && request.auth.uid in data.participantIds;
    }

    function hasSettlementFields(data) {
      return data.keys().hasOnly(
        [
          'participantIds',
          'pairId',
          'fromUserId',
          'toUserId',
          'amountCents',
          'currency',
          'date',
          'note',
          'receiverWalletId',
          'receiverCategoryId',
          'receiverTransactionId',
          'createdBy',
          'createdAt',
          'updatedAt',
          'deletedAt'
        ]
      );
    }

    // The creditor owns the linked income, so only they may clear the link and
    // only while both the stored and the new record are active. A debtor delete
    // with a linked movement is denied: the creditor must unlink first.
    function isSettlementSoftDelete(previous, next) {
      return previous.deletedAt == null
        && next.deletedAt is string
        && isReceiverLinkEmpty(next)
        && (
          previous.receiverTransactionId == null
          || request.auth.uid == previous.toUserId
        )
        && next.diff(previous).affectedKeys().hasOnly(
             request.auth.uid == previous.toUserId
               ? [
                   'deletedAt',
                   'updatedAt',
                   'receiverWalletId',
                   'receiverCategoryId',
                   'receiverTransactionId'
                 ]
               : ['deletedAt', 'updatedAt']
           );
    }

    // A regular edit keeps the record active. The receiver link keys may only
    // change for the creditor, and once an income exists the debtor can no
    // longer resize it (the service rejects it with AMOUNT_LOCKED).
    function isSettlementEdit(previous, next) {
      return previous.deletedAt == null
        && next.deletedAt == null
        && (
          request.auth.uid == previous.toUserId
          || (
            next.receiverWalletId == previous.receiverWalletId
            && next.receiverCategoryId == previous.receiverCategoryId
            && next.receiverTransactionId == previous.receiverTransactionId
          )
        )
        && (
          request.auth.uid == previous.toUserId
          || previous.receiverTransactionId == null
          || next.amountCents == previous.amountCents
        );
    }

    // ---- TICKET-046 notifications ----------------------------------------
    function isNotificationOwner(data) {
      return isSignedIn() && data.userId == request.auth.uid;
    }

    function isNotificationType(value) {
      return value in
        [
          'settlement-created',
          'settlement-updated',
          'settlement-deleted',
          'group-invite',
          'group-join-request',
          'group-join-accepted',
          'group-join-rejected',
          'group-settlement'
        ];
    }

    // Ids, numbers and booleans only: the copy lives in the locales.
    function hasSettlementNotificationPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(
             [
               'settlementId',
               'pairId',
               'friendUid',
               'amountCents',
               'currency',
               'isFull',
               'canLinkWallet'
             ]
           )
        && isSettlementIdValue(payload.settlementId)
        && payload.pairId is string
        && payload.friendUid is string
        && payload.amountCents is int
        && payload.amountCents > 0
        && payload.amountCents <= 100000000
        && payload.currency is string
        && payload.isFull is bool
        && payload.canLinkWallet is bool;
    }

    // `group-invite` payload (TICKET-008): ids plus the denormalized group name,
    // so the invitee row never reads the group. `friendUid` is the inviter.
    function hasGroupInviteNotificationPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(
             ['invitationId', 'groupId', 'groupName', 'friendUid']
           )
        && isGroupText(payload.invitationId, 1500)
        && isGroupText(payload.groupId, 1500)
        && isGroupText(payload.groupName, 60)
        && isGroupText(payload.friendUid, 1500);
    }

    // TICKET-061 payload: request id, group, denormalized name and the actor.
    // On the request event `friendUid` is the requester; on the outcome it is
    // the owner. The copy never names them.
    function hasGroupJoinNotificationPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(
             ['requestId', 'groupId', 'groupName', 'friendUid']
           )
        && isGroupText(payload.requestId, 1500)
        && isGroupText(payload.groupId, 1500)
        && isGroupText(payload.groupName, 60)
        && isGroupText(payload.friendUid, 1500);
    }

    // TICKET-010 group settlement payload: the settlement id, the group, its
    // denormalized name, the actor and the persisted amount and currency.
    function hasGroupSettlementNotificationPayload(payload) {
      return payload is map
        && payload.keys().hasOnly(
             [
               'settlementId',
               'groupId',
               'groupName',
               'friendUid',
               'amountCents',
               'currency'
             ]
           )
        && isSettlementIdValue(payload.settlementId)
        && isGroupText(payload.groupId, 1500)
        && isGroupText(payload.groupName, 60)
        && isGroupText(payload.friendUid, 1500)
        && payload.amountCents is int
        && payload.amountCents > 0
        && payload.amountCents <= 100000000
        && payload.currency is string;
    }

    function hasNotificationPayload(data) {
      return data.type == 'group-invite'
        ? hasGroupInviteNotificationPayload(data.payload)
        : (
            data.type in
              [
                'group-join-request',
                'group-join-accepted',
                'group-join-rejected'
              ]
              ? hasGroupJoinNotificationPayload(data.payload)
              : (
                  data.type == 'group-settlement'
                    ? hasGroupSettlementNotificationPayload(data.payload)
                    : hasSettlementNotificationPayload(data.payload)
                )
          );
    }

    // The invitee is the recipient, the actor is the inviter, and the referenced
    // invitation must agree with the payload. `getAfter` keeps working if a
    // future producer writes the invitation and the notification together.
    function isGroupInviteNotificationTarget(data) {
      return isGroupInviteFor(
        getAfter(
          /databases/$(database)/documents/groups/$(data.payload.groupId)
        ).data,
        getAfter(
          /databases/$(database)/documents/groupInvitations/$(data.payload.invitationId)
        ).data,
        data
      );
    }

    // The referenced group must belong to the actor: an invitation document
    // alone cannot authorize a notification for someone else's group.
    function isGroupInviteFor(group, invitation, notification) {
      return group.ownerId == request.auth.uid
        && invitation.inviteeId == notification.userId
        && invitation.inviterId == request.auth.uid
        && invitation.inviterId == notification.payload.friendUid
        && invitation.groupId == notification.payload.groupId
        && invitation.groupName == notification.payload.groupName
        && invitation.status == 'pending';
    }

    // TICKET-061: the owner receives the request and the requester the outcome.
    // Both events read the request and the group with `getAfter`, so they work
    // whether the notification is written after or with the decision. The
    // deterministic dedupe key is part of the event: a requester cannot mint
    // extra rows by inventing notification ids for the same request.
    function isGroupJoinNotificationTarget(data, notificationId) {
      return data.type == 'group-join-request'
        ? isJoinRequestNotificationFor(
            getAfter(
              /databases/$(database)/documents/groups/$(data.payload.groupId)
            ).data,
            getAfter(
              /databases/$(database)/documents/groupJoinRequests/$(data.payload.requestId)
            ).data,
            data,
            notificationId
          )
        : isJoinOutcomeNotificationFor(
            getAfter(
              /databases/$(database)/documents/groups/$(data.payload.groupId)
            ).data,
            getAfter(
              /databases/$(database)/documents/groupJoinRequests/$(data.payload.requestId)
            ).data,
            data,
            notificationId
          );
    }

    function isJoinRequestNotificationFor(
      group,
      request,
      notification,
      notificationId
    ) {
      return request.groupId == notification.payload.groupId
        && request.requesterId == request.auth.uid
        && request.requesterId == notification.payload.friendUid
        && request.status == 'pending'
        && group.ownerId == notification.userId
        && group.name == notification.payload.groupName
        && notificationId == 'group-join-request:'
             + notification.payload.requestId + ':' + request.createdAt;
    }

    function isJoinOutcomeNotificationFor(
      group,
      request,
      notification,
      notificationId
    ) {
      return request.groupId == notification.payload.groupId
        && request.requesterId == notification.userId
        && group.ownerId == request.auth.uid
        && group.ownerId == notification.payload.friendUid
        && group.name == notification.payload.groupName
        && request.status == (
             notification.type == 'group-join-accepted'
               ? 'accepted'
               : 'rejected'
           )
        && notificationId == notification.type + ':'
             + notification.payload.requestId + ':' + request.updatedAt;
    }

    // The recipient must be the other participant of the referenced settlement
    // and the actor must belong to it. `getAfter` is required because the
    // settlement and its notification are written in the same transaction.
    // The amount and currency must match the persisted settlement, so the
    // payload can never claim a debt the record does not contain (create,
    // update and delete truncate both fields from the same settlement).
    function isNotificationTargetFor(settlement, notification) {
      return settlement.participantIds is list
        && request.auth.uid in settlement.participantIds
        && notification.userId in settlement.participantIds
        && notification.userId != request.auth.uid
        && notification.payload.friendUid == request.auth.uid
        && notification.payload.pairId == settlement.pairId
        && notification.payload.amountCents == settlement.amountCents
        && notification.payload.currency == settlement.currency;
    }

    // TICKET-010: the recipient is the other member of the pair, the actor is a
    // participant, and the payload must agree with the persisted settlement and
    // its group. One settlement read plus one group read.
    function isGroupSettlementNotificationTarget(data) {
      return isGroupSettlementNotificationFor(
        getAfter(
          /databases/$(database)/documents/groupSettlements/$(data.payload.settlementId)
        ).data,
        get(
          /databases/$(database)/documents/groups/$(data.payload.groupId)
        ).data,
        data
      );
    }

    function isGroupSettlementNotificationFor(settlement, group, notification) {
      return settlement.participantIds is list
        && request.auth.uid in settlement.participantIds
        && notification.userId in settlement.participantIds
        && notification.userId != request.auth.uid
        && notification.payload.friendUid == request.auth.uid
        && notification.payload.groupId == settlement.groupId
        && group.name == notification.payload.groupName
        && notification.payload.amountCents == settlement.amountCents
        && notification.payload.currency == settlement.currency;
    }

    // The actor writes the notification for the other participant and must read
    // the deterministic document inside the same transaction to stay idempotent.
    // `list` stays owner-only; this is a single-document `get` for a settlement
    // the actor participates in, and `getAfter` covers the create in the same
    // write. The actor already knows the settlement, so the trade-off is the
    // recipient's `readAt`, not new financial data.
    function isSettlementNotificationActor(data) {
      return isSignedIn()
        && data.userId != request.auth.uid
        && data.payload is map
        // Presence guard: a group-invite payload has no settlementId, and
        // reading a missing map key would fail the whole get evaluation.
        && ('settlementId' in data.payload)
        && data.payload.settlementId is string
        && request.auth.uid in getAfter(
             /databases/$(database)/documents/settlements/$(data.payload.settlementId)
           ).data.participantIds;
    }

    // TICKET-010 actor grant for the group settlement row: same narrow trade-off
    // as the 1:1 one, on the `groupSettlements` path so a settlement notification
    // never reads another collection.
    function isGroupSettlementNotificationActor(data) {
      return isSignedIn()
        && data.type == 'group-settlement'
        && data.userId != request.auth.uid
        && data.payload is map
        && ('settlementId' in data.payload)
        && data.payload.settlementId is string
        && request.auth.uid in getAfter(
             /databases/$(database)/documents/groupSettlements/$(data.payload.settlementId)
           ).data.participantIds;
    }

    // The inviter may read the deterministic `group-invite` document so
    // `createNotificationOperation` can skip an already written event. The
    // recipient's readAt stays private because this only matches the actor.
    function isGroupInviteNotificationActor(data) {
      return isSignedIn()
        && data.type == 'group-invite'
        && data.payload is map
        && ('friendUid' in data.payload)
        && data.payload.friendUid == request.auth.uid;
    }

    // TICKET-061 actor: the requester on the request event and the owner on the
    // outcome. Same narrow grant as group-invite: only their own dedupe id.
    function isGroupJoinNotificationActor(data) {
      return isSignedIn()
        && data.type in
          [
            'group-join-request',
            'group-join-accepted',
            'group-join-rejected'
          ]
        && data.payload is map
        && ('friendUid' in data.payload)
        && data.payload.friendUid == request.auth.uid;
    }

    // Shared expense and group expense links are expense-only; a settlement and
    // a group settlement link are income-only. All optional, but a movement can
    // never carry two at once.
    function hasNoDoubleLink(data) {
      return !(
        (('sharedExpenseId' in data) && ('groupExpenseId' in data))
        || (('sharedExpenseId' in data) && ('settlementId' in data))
        || (('groupExpenseId' in data) && ('settlementId' in data))
        || (('groupSettlementId' in data) && ('sharedExpenseId' in data))
        || (('groupSettlementId' in data) && ('groupExpenseId' in data))
        || (('groupSettlementId' in data) && ('settlementId' in data))
      );
    }

    function hasValidSettlementLink(data) {
      return data.type == 'income'
        && isSettlementIdValue(data.settlementId)
        && isSettlementIncomeTarget(
             getAfter(
               /databases/$(database)/documents/settlements/$(data.settlementId)
             ).data,
             data
           );
    }

    function isSettlementIncomeTarget(settlement, movement) {
      return settlement.participantIds is list
        && request.auth.uid in settlement.participantIds
        && settlement.toUserId == request.auth.uid
        && settlement.currency == movement.currency
        && settlement.deletedAt == null;
    }

    function keepsSettlementLink(previous, next) {
      return ('settlementId' in previous) == ('settlementId' in next)
        && (
          !('settlementId' in previous)
          || previous.settlementId == next.settlementId
        );
    }

    // TICKET-010 group settlement mirror: the income belongs to the creditor of
    // the pair inside a group they still belong to. One settlement read plus one
    // group read, still under the 10-document budget.
    function hasValidGroupSettlementLink(data) {
      return data.type == 'income'
        && isSettlementIdValue(data.groupSettlementId)
        && isGroupSettlementIncomeTarget(
             getAfter(
               /databases/$(database)/documents/groupSettlements/$(data.groupSettlementId)
             ).data,
             data
           );
    }

    function isGroupSettlementIncomeTarget(settlement, movement) {
      return settlement.participantIds is list
        && settlement.toUserId == request.auth.uid
        && settlement.currency == movement.currency
        && settlement.deletedAt == null
        && request.auth.uid in get(
             /databases/$(database)/documents/groups/$(settlement.groupId)
           ).data.memberIds;
    }

    function keepsGroupSettlementLink(previous, next) {
      return ('groupSettlementId' in previous) == ('groupSettlementId' in next)
        && (
          !('groupSettlementId' in previous)
          || previous.groupSettlementId == next.groupSettlementId
        );
    }

    // ---- TICKET-008 groups -----------------------------------------------
    // A group belongs to one owner and only its accepted members read it.
    // Membership otherwise only grows through an accepted invitation, which is
    // verified with `getAfter` so it can be written in the same transaction.
    // Group expenses and their ledger stay in TICKET-009/010.
    function isGroupMember(data) {
      return isSignedIn() && request.auth.uid in data.memberIds;
    }

    function isGroupText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // Bounded by GROUP_DESCRIPTION_MAX_LENGTH (200) in the group schema.
    function isGroupDescription(value) {
      return value == null || (value is string && value.size() <= 200);
    }

    function hasGroupCurrency(value) {
      return value in ['EUR', 'USD', 'GBP', 'JPY', 'CHF'];
    }

    // TICKET-061 join code: 8 chars from the bias-free alphabet (no 0/O/1/I).
    // Mirrors GROUP_JOIN_CODE_ALPHABET in the client.
    function isGroupJoinCode(value) {
      return value is string
        && value.size() == 8
        && value.matches('^[2-9A-HJ-NP-Z]{8}$');
    }

    // Owner first, unique and 1..20 (GROUP_MAX_MEMBERS), the same contract as
    // the mapper and the service.
    function hasGroupMembers(memberIds, ownerId) {
      return memberIds is list
        && memberIds.size() > 0
        && memberIds.size() <= 20
        && memberIds[0] == ownerId
        && memberIds.toSet().size() == memberIds.size();
    }

    function keepsGroupIdentity(previous, next) {
      return next.ownerId == previous.ownerId
        && next.createdAt == previous.createdAt;
    }

    // a) owner metadata edit: membership, owner and creation stamp are frozen.
    //    `simplifyDebts` (TICKET-010) is the simplify toggle, on by default; the
    //    client always writes it on a metadata edit, so a legacy group gains it.
    function isGroupMetadataEdit(previous, next) {
      return previous.ownerId == request.auth.uid
        && next.diff(previous).affectedKeys().hasOnly(
             [
               'name',
               'description',
               'defaultCurrency',
               'simplifyDebts',
               'updatedAt'
             ]
           )
        && isGroupText(next.name, 60)
        && isGroupDescription(next.description)
        && hasGroupCurrency(next.defaultCurrency)
        && next.simplifyDebts is bool
        && next.updatedAt is string;
    }

    // b) owner removes exactly one member; the owner can never leave.
    function isGroupMemberRemoval(previous, next) {
      return previous.ownerId == request.auth.uid
        && next.diff(previous).affectedKeys().hasOnly(['memberIds', 'updatedAt'])
        && next.memberIds.size() == previous.memberIds.size() - 1
        && previous.memberIds.toSet().hasAll(next.memberIds)
        && hasGroupMembers(next.memberIds, previous.ownerId)
        && next.updatedAt is string;
    }

    // Deterministic invitation id: `groupId__inviteeId`.
    function isGroupInvitationParticipant(data) {
      return isSignedIn()
        && (
          data.inviterId == request.auth.uid
          || data.inviteeId == request.auth.uid
        );
    }

    function isGroupInvitationPair(data) {
      return data.pairId is string
        && data.pairId == (
             data.inviterId < data.inviteeId
               ? data.inviterId + '__' + data.inviteeId
               : data.inviteeId + '__' + data.inviterId
           );
    }

    // ONE friendship read per invitation create, passed into the helper, so a
    // 19-invite creation batch stays inside the document-read budget. The group
    // is never read here: the group update rule verifies the inviter instead.
    function isFriendshipOf(friendship, first, second) {
      return friendship.memberIds is list
        && first in friendship.memberIds
        && second in friendship.memberIds;
    }

    function hasGroupInvitationFields(data) {
      return data.keys().hasOnly(
          [
            'groupId',
            'groupName',
            'inviterId',
            'inviteeId',
            'pairId',
            'status',
            'createdAt',
            'updatedAt'
          ]
        )
        && isGroupText(data.groupId, 1500)
        && isGroupText(data.groupName, 60)
        && isGroupText(data.inviterId, 1500)
        && isGroupText(data.inviteeId, 1500)
        && data.status in ['pending', 'accepted', 'rejected', 'cancelled']
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function keepsGroupInvitationIdentity(previous, next) {
      return next.inviterId == previous.inviterId
        && next.inviteeId == previous.inviteeId
        && next.groupId == previous.groupId
        && next.pairId == previous.pairId
        && next.createdAt == previous.createdAt;
    }

    function isInvitationStatusChange(previous, next) {
      return next.diff(previous).affectedKeys().hasOnly(['status', 'updatedAt']);
    }

    // Invitee: pending -> accepted | rejected.
    function isInviteeInvitationResponse(previous, next) {
      return previous.inviteeId == request.auth.uid
        && previous.status == 'pending'
        && next.status in ['accepted', 'rejected']
        && isInvitationStatusChange(previous, next);
    }

    // Inviter: pending -> cancelled.
    function isInviterInvitationCancel(previous, next) {
      return previous.inviterId == request.auth.uid
        && previous.status == 'pending'
        && next.status == 'cancelled'
        && isInvitationStatusChange(previous, next);
    }

    // Inviter rename propagation while the invitation is still pending.
    function isInvitationRename(previous, next) {
      return previous.inviterId == request.auth.uid
        && previous.status == 'pending'
        && next.status == 'pending'
        && isGroupText(next.groupName, 60)
        && next.diff(previous).affectedKeys().hasOnly(
             ['groupName', 'updatedAt']
           );
    }

    // Inviter re-invite: a rejected/cancelled (or accepted-then-removed) row is
    // reopened instead of duplicated; the service only does it for non-members.
    function isInvitationReopen(previous, next) {
      return previous.inviterId == request.auth.uid
        && previous.status in ['rejected', 'cancelled', 'accepted']
        && next.status == 'pending'
        && isInvitationStatusChange(previous, next);
    }

    function isAcceptedGroupInvitation(invitation, groupId, ownerId) {
      return invitation.groupId == groupId
        && invitation.inviteeId == request.auth.uid
        && invitation.inviterId == ownerId
        && invitation.status == 'accepted';
    }

    // c) invitee joins: exactly one uid is appended, the owner stays first and
    // the same transaction must set the deterministic invitation to accepted.
    function joinsGroupThroughInvitation(previous, next, groupId) {
      return !(request.auth.uid in previous.memberIds)
        && request.auth.uid in next.memberIds
        && next.diff(previous).affectedKeys().hasOnly(
             ['memberIds', 'updatedAt']
           )
        && next.memberIds.size() == previous.memberIds.size() + 1
        && next.memberIds.toSet().hasAll(previous.memberIds)
        && hasGroupMembers(next.memberIds, previous.ownerId)
        && next.updatedAt is string
        && isAcceptedGroupInvitation(
             getAfter(
               /databases/$(database)/documents/groupInvitations/$(groupId + '__' + request.auth.uid)
             ).data,
             groupId,
             previous.ownerId
           );
    }

    // The invitee reads the group inside the accept transaction, so a pending
    // deterministic invitation also grants that single-document get. A missing
    // invitation makes `get` fail, which denies the read. The stored groupId is
    // re-checked against the path, so the grant is tied to this exact group.
    function isPendingInvitationForGroup(invitation, groupId) {
      return invitation.status == 'pending'
        && invitation.groupId == groupId;
    }

    function hasPendingGroupInvitation(groupId) {
      return isPendingInvitationForGroup(
        get(
          /databases/$(database)/documents/groupInvitations/$(groupId + '__' + request.auth.uid)
        ).data,
        groupId
      );
    }

    // TICKET-061 lazy code for a group created before the field existed: the
    // owner may only add `joinCode` (never rotate it) and stamp `updatedAt`.
    function isGroupJoinCodeBackfill(previous, next) {
      return previous.ownerId == request.auth.uid
        && !('joinCode' in previous)
        && isGroupJoinCode(next.joinCode)
        && next.diff(previous).affectedKeys().hasOnly(['joinCode', 'updatedAt'])
        && next.updatedAt is string;
    }

    // The single uid appended by an acceptance; size + hasAll prove it is one.
    function addedGroupMember(previous, next) {
      return next.memberIds.removeAll(previous.memberIds)[0];
    }

    function isAcceptedJoinRequest(request, groupId, requesterId) {
      return request.groupId == groupId
        && request.requesterId == requesterId
        && request.status == 'accepted';
    }

    // d) owner accepts a join request: the request must already read accepted
    // with `getAfter` and the appended uid must be its requester.
    function joinsGroupThroughJoinRequest(previous, next, groupId) {
      return previous.ownerId == request.auth.uid
        && next.diff(previous).affectedKeys().hasOnly(
             ['memberIds', 'updatedAt']
           )
        && next.memberIds.size() == previous.memberIds.size() + 1
        && next.memberIds.toSet().hasAll(previous.memberIds)
        && hasGroupMembers(next.memberIds, previous.ownerId)
        && next.updatedAt is string
        && isAcceptedJoinRequest(
             getAfter(
               /databases/$(database)/documents/groupJoinRequests/$(groupId + '__' + addedGroupMember(previous, next))
             ).data,
             groupId,
             addedGroupMember(previous, next)
           );
    }

    // Group ids are owner-namespaced: `${ownerId}__${autoId}`. Only the owner can
    // create a group under their prefix, so an invitation create proves its
    // group belongs to the caller WITHOUT reading the group. That keeps the
    // budget at one friendship read per invitation (19 < 20 for a full batch)
    // and closes forged invitations into someone else's group. `split` is used
    // instead of a regex: Firebase uids and auto ids are alphanumeric, so the
    // separator is unambiguous and no caller input reaches a pattern.
    function isOwnedGroupId(groupId, ownerId) {
      return groupId is string
        && groupId.size() > ownerId.size() + 2
        && groupId.split('__').size() >= 2
        && groupId.split('__')[0] == ownerId;
    }

    // Profiles keep the Firebase uid in the `uid` field and are looked up by
    // it. Only the owner can read or update the document, and the uid cannot
    // be reassigned after creation.
    match /users/{userId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow read, delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
    }

    match /wallets/{walletId} {
      allow read, delete: if isWalletOwner(resource.data);

      allow create: if isWalletOwner(request.resource.data);

      allow update: if isWalletOwner(resource.data)
        && isWalletOwner(request.resource.data);
    }

    match /transactions/{transactionId} {
      allow read: if isWalletOwner(resource.data);

      // A linked movement is an expense of the payer whose referenced expense
      // must exist once this write is applied (same transaction included), or an
      // income of the creditor of the referenced settlement.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && hasNoDoubleLink(request.resource.data)
        && (
          !('sharedExpenseId' in request.resource.data)
          || hasValidSharedExpenseLink(request.resource.data)
        )
        && (
          !('groupExpenseId' in request.resource.data)
          || hasValidGroupExpenseLink(request.resource.data)
        )
        && (
          !('settlementId' in request.resource.data)
          || hasValidSettlementLink(request.resource.data)
        )
        && (
          !('groupSettlementId' in request.resource.data)
          || hasValidGroupSettlementLink(request.resource.data)
        );

      // An update must still be a valid linked record. `get` covers the stored
      // state (edit, soft delete) and `getAfter` covers an atomic currency edit
      // where the source record and the movement change currency together.
      allow update: if isWalletOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && keepsSharedExpenseLink(resource.data, request.resource.data)
        && keepsGroupExpenseLink(resource.data, request.resource.data)
        && keepsSettlementLink(resource.data, request.resource.data)
        && keepsGroupSettlementLink(resource.data, request.resource.data)
        && hasNoDoubleLink(request.resource.data)
        && (
          !('sharedExpenseId' in request.resource.data)
          || (
            request.resource.data.type == 'expense'
            && (
              isSharedExpenseLinkTarget(
                get(
                  /databases/$(database)/documents/sharedExpenses/$(request.resource.data.sharedExpenseId)
                ).data,
                request.resource.data
              )
              || isSharedExpenseLinkTarget(
                getAfter(
                  /databases/$(database)/documents/sharedExpenses/$(request.resource.data.sharedExpenseId)
                ).data,
                request.resource.data
              )
            )
          )
        )
        && (
          !('groupExpenseId' in request.resource.data)
          || (
            request.resource.data.type == 'expense'
            && (
              isGroupExpenseLinkTarget(
                get(
                  /databases/$(database)/documents/groupExpenses/$(request.resource.data.groupExpenseId)
                ).data,
                request.resource.data
              )
              || isGroupExpenseLinkTarget(
                getAfter(
                  /databases/$(database)/documents/groupExpenses/$(request.resource.data.groupExpenseId)
                ).data,
                request.resource.data
              )
            )
          )
        )
        && (
          !('settlementId' in request.resource.data)
          || (
            request.resource.data.type == 'income'
            && (
              isSettlementIncomeTarget(
                get(
                  /databases/$(database)/documents/settlements/$(request.resource.data.settlementId)
                ).data,
                request.resource.data
              )
              || isSettlementIncomeTarget(
                getAfter(
                  /databases/$(database)/documents/settlements/$(request.resource.data.settlementId)
                ).data,
                request.resource.data
              )
            )
          )
        )
        && (
          !('groupSettlementId' in request.resource.data)
          || (
            request.resource.data.type == 'income'
            && (
              isGroupSettlementIncomeTarget(
                get(
                  /databases/$(database)/documents/groupSettlements/$(request.resource.data.groupSettlementId)
                ).data,
                request.resource.data
              )
              || isGroupSettlementIncomeTarget(
                getAfter(
                  /databases/$(database)/documents/groupSettlements/$(request.resource.data.groupSettlementId)
                ).data,
                request.resource.data
              )
            )
          )
        );

      // Linked movements are only ever soft-deleted by their operations; a hard
      // delete would leave the shared expense, the group expense, the settlement
      // or the group settlement pointing nowhere.
      allow delete: if isWalletOwner(resource.data)
        && !('sharedExpenseId' in resource.data)
        && !('groupExpenseId' in resource.data)
        && !('settlementId' in resource.data)
        && !('groupSettlementId' in resource.data);
    }

    // User-defined categories. The type is fixed after creation so historical
    // transaction/category type pairs stay consistent.
    match /categories/{categoryId} {
      allow read: if isWalletOwner(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isWalletOwner(resource.data)
        && isWalletOwner(request.resource.data)
        && request.resource.data.type == resource.data.type;

      allow delete: if isWalletOwner(resource.data);
    }

    // Transfers support edit and soft delete. Documents are never hard-deleted:
    // deletedAt marks a transfer whose balances were already reverted.
    match /transfers/{transferId} {
      allow read: if isWalletOwner(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isWalletOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    // Public identity shared with other signed-in users: display name plus the
    // normalized email used by the exact-match search. The document id is the
    // uid, only its owner writes it and the uid cannot be reassigned.
    match /publicProfiles/{profileId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
        && profileId == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'displayName', 'email', 'createdAt', 'updatedAt']
           )
        && isOwnTokenEmail(request.resource.data)
        && isDisplayNameValue(request.resource.data.displayName)
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;

      allow update: if isSignedIn()
        && profileId == request.auth.uid
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['displayName', 'email', 'updatedAt']
           )
        && isOwnTokenEmail(request.resource.data)
        && isDisplayNameValue(request.resource.data.displayName)
        && request.resource.data.updatedAt is string;

      allow delete: if false;
    }

    // Friend requests live in the deterministic pair document. Only the two
    // participants read it, and only three transitions are allowed:
    // cancel (sender), reject (recipient) and re-open (either member, whose
    // requester/recipient pair is swapped when the other user now asks).
    match /friendRequests/{requestId} {
      // A `get` on a missing pair document must resolve to "not found" instead
      // of permission-denied, so sending a first request can decide whether to
      // create or re-open it. This is a deliberate existence oracle trade-off:
      // a signed-in caller can learn whether a pair document exists, but a
      // missing document holds no data. Never loosen reads of existing
      // documents, which stay participant-only.
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/friendRequests/$(requestId))
          || isRequestParticipant(resource.data)
        );

      allow list: if isRequestParticipant(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'pending'
        && hasSortedPair(request.resource.data.participantIds)
        && pairIdMatches(requestId, request.resource.data.participantIds)
        && request.resource.data.requesterId
             in request.resource.data.participantIds
        && request.resource.data.recipientId
             in request.resource.data.participantIds
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly(
             [
               'requesterId',
               'recipientId',
               'participantIds',
               'status',
               'createdAt',
               'updatedAt'
             ]
           )
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.recipientId))
        // A live request and an accepted friendship must never coexist.
        && !exists(/databases/$(database)/documents/friendships/$(requestId));

      allow update: if isRequestParticipant(resource.data)
        && isRequestParticipant(request.resource.data)
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (
            resource.data.status == 'pending'
            && request.resource.data.status == 'cancelled'
            && resource.data.requesterId == request.auth.uid
            && request.resource.data.requesterId == resource.data.requesterId
            && request.resource.data.recipientId == resource.data.recipientId
            && request.resource.data.updatedAt is string
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.status == 'pending'
            && request.resource.data.status == 'rejected'
            && resource.data.recipientId == request.auth.uid
            && request.resource.data.requesterId == resource.data.requesterId
            && request.resource.data.recipientId == resource.data.recipientId
            && request.resource.data.updatedAt is string
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'updatedAt'])
          )
          || (
            resource.data.status in ['rejected', 'cancelled']
            && request.resource.data.status == 'pending'
            && request.resource.data.requesterId == request.auth.uid
            && request.resource.data.recipientId != request.auth.uid
            && request.resource.data.requesterId
                 in request.resource.data.participantIds
            && request.resource.data.recipientId
                 in request.resource.data.participantIds
            && request.resource.data.updatedAt is string
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                 ['status', 'requesterId', 'recipientId', 'updatedAt']
               )
            // Re-opening must not resurrect a request for an existing friend.
            && !exists(/databases/$(database)/documents/friendships/$(requestId))
          )
        );

      // Inside the accept batch, rules see the pre-batch request, so only the
      // recipient deletes it and only while it is still pending.
      allow delete: if isRequestParticipant(resource.data)
        && resource.data.recipientId == request.auth.uid
        && resource.data.status == 'pending';
    }

    // Accepted relationships. The friendship is the single source of truth and
    // is created by the accept batch, which deletes the pending request in the
    // same write; either member can remove the friend (no blocking).
    match /friendships/{friendshipId} {
      // Same "missing means not a friend" contract as the requests: a `get` on
      // a pair without friendship resolves to not-found so `removeFriend` can
      // answer FRIEND_NOT_FOUND instead of permission-denied. The trade-off is
      // a harmless existence oracle: missing documents hold no data, while
      // existing friendships stay member-only.
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/friendships/$(friendshipId))
          || isFriendMember(resource.data)
        );

      allow list: if isFriendMember(resource.data);

      allow delete: if isFriendMember(resource.data);

      allow create: if isSignedIn()
        && hasSortedPair(request.resource.data.memberIds)
        && pairIdMatches(friendshipId, request.resource.data.memberIds)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.recipientId == request.auth.uid
        && request.resource.data.requesterId != request.auth.uid
        && request.resource.data.requesterId
             in request.resource.data.memberIds
        && request.resource.data.recipientId
             in request.resource.data.memberIds
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly(
             ['memberIds', 'requesterId', 'recipientId', 'createdAt']
           )
        && exists(/databases/$(database)/documents/friendRequests/$(friendshipId))
        && requestMatchesAcceptance(
             get(/databases/$(database)/documents/friendRequests/$(friendshipId)).data,
             request.resource.data.memberIds
           );

      // Friendships are immutable; removing a friend deletes the document.
      allow update: if false;
    }

    // 1:1 shared expenses. Both participants read the record and either one can
    // edit it or mark it deleted; nothing is ever hard-deleted. The pair and the
    // creation stamp are immutable, and a soft-deleted record cannot be edited
    // back to life (`resource.data.deletedAt == null` on update).
    //
    // TICKET-055: no payer wallet is required any more, a viewer-paid expense may
    // be social-only. What is required is the link pair (wallet + category
    // together, see `hasExpenseLinkCoherence`) whenever a link exists.
    //
    // No composite index: `getSharedExpensesOperation` filters only with
    // `where('participantIds', 'array-contains', uid)` and sorts client-side.
    match /sharedExpenses/{expenseId} {
      allow get, list: if isExpenseParticipant(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && hasExpensePair(request.resource.data)
        && hasExpenseMoney(request.resource.data)
        && hasExpenseShares(request.resource.data)
        && hasExpenseFields(request.resource.data)
        && hasExpenseLinks(request.resource.data)
        && hasExpenseLinkCoherence(request.resource.data)
        && request.resource.data.currency is string
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.deletedAt == null
        && exists(
             /databases/$(database)/documents/friendships/$(request.resource.data.pairId)
           );

      allow update: if isExpenseParticipant(resource.data)
        && resource.data.deletedAt == null
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.pairId == resource.data.pairId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && hasExpensePair(request.resource.data)
        && hasExpenseMoney(request.resource.data)
        && hasExpenseShares(request.resource.data)
        && hasExpenseFields(request.resource.data)
        && hasExpenseLinks(request.resource.data)
        && (isExpenseSoftDelete(resource.data, request.resource.data)
            || hasExpenseLinkCoherence(request.resource.data))
        && request.resource.data.currency is string
        && request.resource.data.updatedAt is string
        && isExpenseDeletedAt(request.resource.data.deletedAt);

      allow delete: if false;
    }

    // 1:1 debt settlements. Applied directly: `deletedAt: null` means active and
    // every active settlement feeds the pair ledger; a soft-deleted one never
    // does. Both participants read it and either one can create it (the service
    // derives the direction), but only the creditor may link a wallet. The pair,
    // the direction, the currency and the creation stamp are immutable and the
    // record is never hard-deleted.
    //
    // No composite index: `getSettlementsOperation` filters only with
    // `where('participantIds', 'array-contains', uid)` and sorts client-side.
    match /settlements/{settlementId} {
      allow get, list: if isSettlementParticipant(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && hasSettlementPair(request.resource.data)
        && hasSettlementMoney(request.resource.data)
        && hasSettlementFields(request.resource.data)
        && hasSettlementLinkShape(request.resource.data)
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.deletedAt == null
        // Only the creditor ever links the income, so a debtor create is always
        // social-only.
        && (
          request.resource.data.createdBy == request.resource.data.toUserId
          || isReceiverLinkEmpty(request.resource.data)
        )
        && exists(
             /databases/$(database)/documents/friendships/$(request.resource.data.pairId)
           );

      allow update: if isSettlementParticipant(resource.data)
        && resource.data.deletedAt == null
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.pairId == resource.data.pairId
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && hasSettlementPair(request.resource.data)
        && hasSettlementMoney(request.resource.data)
        && hasSettlementFields(request.resource.data)
        && hasSettlementLinkShape(request.resource.data)
        && request.resource.data.updatedAt is string
        && (
          isSettlementSoftDelete(resource.data, request.resource.data)
          || isSettlementEdit(resource.data, request.resource.data)
        );

      allow delete: if false;
    }

    // Groups (TICKET-008). Created in one batch with its pending invitations and
    // its join-code projection (TICKET-061); the owner edits metadata and removes
    // members; membership only grows through an accepted invitation or an
    // owner-accepted join request. No balance is validated here: group expenses
    // and their ledger are TICKET-009/010.
    //
    // No composite index: `getGroupsOperation` filters only with
    // `where('memberIds', 'array-contains', uid)` and sorts client-side.
    match /groups/{groupId} {
      // The invitee reads the group inside the accept transaction, so a pending
      // invitation grants that single `get`. `list` stays member-only, which the
      // `array-contains` query proves.
      allow get: if isGroupMember(resource.data)
        || hasPendingGroupInvitation(groupId);

      allow list: if isGroupMember(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isOwnedGroupId(groupId, request.auth.uid)
        && request.resource.data.memberIds == [request.auth.uid]
        && isGroupText(request.resource.data.name, 60)
        && isGroupDescription(request.resource.data.description)
        && hasGroupCurrency(request.resource.data.defaultCurrency)
        && isGroupJoinCode(request.resource.data.joinCode)
        && request.resource.data.simplifyDebts is bool
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly(
             [
               'ownerId',
               'memberIds',
               'name',
               'description',
               'defaultCurrency',
               'joinCode',
               'simplifyDebts',
               'createdAt',
               'updatedAt'
             ]
           );

      allow update: if keepsGroupIdentity(resource.data, request.resource.data)
        && (
          isGroupMetadataEdit(resource.data, request.resource.data)
          || isGroupMemberRemoval(resource.data, request.resource.data)
          || joinsGroupThroughInvitation(
               resource.data,
               request.resource.data,
               groupId
             )
          || isGroupJoinCodeBackfill(resource.data, request.resource.data)
          || joinsGroupThroughJoinRequest(
               resource.data,
               request.resource.data,
               groupId
             )
        );

      allow delete: if false;
    }

    // ---- TICKET-009 group expenses ---------------------------------------
    // Root `groupExpenses/{expenseId}` with a `groupId` field: the client queries
    // with one single-field `where('groupId', '==', groupId)` and sorts
    // client-side, so no composite index is required. A
    // `groups/{groupId}/expenses` subcollection would save the group read below
    // but make a cross-group query impossible without a collection-group index.
    //
    // Access is proven with ONE group read (`memberIds`/`ownerId`); Firestore
    // caches repeated reads of the same document inside a request, so a `list`
    // pays it once. Rules cannot iterate a list, so the per-row participant check
    // (uid is a member, uids are unique, shares sum to `amountCents`) stays in
    // the schema and the service: the same class of trade-off as "rules cannot
    // sum". Only the list shape and its first row are checked here.
    function groupExpenseGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupExpenseRow(row) {
      return row is map
        && row.keys().hasOnly(
             ['userId', 'shareCents', 'percentageBps', 'weight']
           )
        && row.userId is string
        && row.userId.size() > 0
        && row.shareCents is int
        && row.shareCents >= 0
        && row.shareCents <= 100000000;
    }

    function hasGroupExpenseShares(data) {
      return data.participants is list
        && data.participants.size() >= 1
        && data.participants.size() <= 20
        && isGroupExpenseRow(data.participants[0]);
    }

    // Bounded by GROUP_EXPENSE_AMOUNT_MAX_CENTS (100,000,000) and
    // GROUP_EXPENSE_DESCRIPTION_MAX_LENGTH (120) in the group-expense schema.
    function hasGroupExpenseMoney(data) {
      return data.amountCents is int
        && data.amountCents > 0
        && data.amountCents <= 100000000
        && hasGroupCurrency(data.currency)
        && data.splitMode in ['equal', 'percentage', 'fixed', 'shares']
        && data.description is string
        && data.description.size() > 0
        && data.description.size() <= 120
        && data.date is string;
    }

    function hasGroupExpenseFields(data) {
      return data.keys().hasOnly(
        [
          'groupId',
          'payerId',
          'amountCents',
          'currency',
          'splitMode',
          'participants',
          'description',
          'date',
          'walletId',
          'categoryId',
          'linkedTransactionId',
          'createdBy',
          'createdAt',
          'updatedAt',
          'deletedAt'
        ]
      );
    }

    // Identity and stamps: `groupId`, `createdBy` and `createdAt` are immutable.
    function hasGroupExpenseIdentity(data) {
      return isGroupText(data.groupId, 1500)
        && isGroupText(data.payerId, 1500)
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // Read: any active member of the expense group.
    function isGroupExpenseMember(data) {
      return isSignedIn()
        && request.auth.uid in groupExpenseGroup(data.groupId).memberIds;
    }

    // Create: the caller writes their own record and both the caller and the
    // payer are active members of the target group.
    function isGroupExpenseCreateTarget(data, group) {
      return data.createdBy == request.auth.uid
        && request.auth.uid in group.memberIds
        && data.payerId in group.memberIds;
    }

    // Owner, creator or payer; everyone else is read-only.
    function isGroupExpenseEditor(data, group) {
      return request.auth.uid in group.memberIds
        && (
          data.createdBy == request.auth.uid
          || data.payerId == request.auth.uid
          || group.ownerId == request.auth.uid
        );
    }

    // Edits keep the group, the creator and the creation stamp frozen, the payer
    // inside the group and `deletedAt` null or an ISO string. A soft-deleted
    // expense is never edited nor resurrected (`previous.deletedAt == null`).
    function isGroupExpenseUpdateTarget(previous, next, group) {
      return previous.deletedAt == null
        && isGroupExpenseEditor(previous, group)
        && next.groupId == previous.groupId
        && next.createdBy == previous.createdBy
        && next.createdAt == previous.createdAt
        && next.payerId in group.memberIds
        && (next.deletedAt == null || next.deletedAt is string);
    }

    // The unlinked soft delete touches nothing but the two deletion stamps.
    function isGroupExpenseSoftDelete(previous, next) {
      return next.deletedAt is string
        && next.diff(previous).affectedKeys().hasOnly(['deletedAt', 'updatedAt']);
    }

    // The linked soft delete clears the whole link as a unit: wallet, category
    // and movement reference are all null, so a closed expense keeps no wallet
    // that could outlive its movement.
    function isGroupExpenseLinkedSoftDelete(previous, next) {
      return next.deletedAt is string
        && next.diff(previous).affectedKeys().hasOnly(
             [
               'deletedAt',
               'updatedAt',
               'walletId',
               'categoryId',
               'linkedTransactionId'
             ]
           )
        && next.get('walletId', null) == null
        && next.get('categoryId', null) == null
        && next.get('linkedTransactionId', null) == null;
    }

    // A regular edit may not add, clear or rewrite the deletion stamp. The link
    // keys travel here when the payer links, moves or clears the wallet.
    function isGroupExpenseEdit(previous, next) {
      return next.deletedAt == null
        && next.diff(previous).affectedKeys().hasOnly(
             [
               'payerId',
               'amountCents',
               'currency',
               'splitMode',
               'participants',
               'description',
               'date',
               'walletId',
               'categoryId',
               'linkedTransactionId',
               'updatedAt'
             ]
           );
    }

    // ---- TICKET-010 group settlements ------------------------------------
    // A group settlement cancels a pair debt inside a group and is applied by
    // existing: `deletedAt: null` counts in the ledger, a soft-deleted row never
    // does. Rules cannot sum the group ledger, so the pair direction and the
    // debt bound stay in the service; here only the shape, the membership, the
    // pair and the creditor-only receiver link are validated.
    //
    // No composite index: the repository filters only with
    // `where('groupId', '==', groupId)` and sorts client-side.
    function groupSettlementGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isGroupSettlementLinkEmpty(data) {
      return data.receiverWalletId == null
        && data.receiverCategoryId == null
        && data.receiverTransactionId == null;
    }

    function isGroupSettlementLinkComplete(data) {
      return isSettlementIdValue(data.receiverWalletId)
        && isSettlementIdValue(data.receiverCategoryId)
        && isSettlementIdValue(data.receiverTransactionId);
    }

    // Never a partial link: an income without its wallet or category could not
    // be reverted by anyone.
    function hasGroupSettlementLinkShape(data) {
      return isGroupSettlementLinkEmpty(data)
        || isGroupSettlementLinkComplete(data);
    }

    // Bounded by SETTLEMENT_AMOUNT_MAX_CENTS (100,000,000) and
    // SETTLEMENT_NOTE_MAX_LENGTH (500), shared with the 1:1 settlement schema.
    function hasGroupSettlementMoney(data) {
      return data.amountCents is int
        && data.amountCents > 0
        && data.amountCents <= 100000000
        && hasGroupCurrency(data.currency)
        && data.date is string
        && data.note is string
        && data.note.size() <= 500;
    }

    // Exactly two sorted pair members, the debtor/creditor inside them and the
    // caller as one of the two: only the pair records or edits the settlement.
    function hasGroupSettlementPair(data) {
      return hasSortedPair(data.participantIds)
        && data.pairId == data.participantIds[0] + '__' + data.participantIds[1]
        && data.fromUserId in data.participantIds
        && data.toUserId in data.participantIds
        && data.fromUserId != data.toUserId
        && request.auth.uid in data.participantIds;
    }

    function hasGroupSettlementFields(data) {
      return isGroupText(data.groupId, 1500)
        && data.createdAt is string
        && data.updatedAt is string
        && data.keys().hasOnly(
             [
               'groupId',
               'participantIds',
               'pairId',
               'fromUserId',
               'toUserId',
               'amountCents',
               'currency',
               'date',
               'note',
               'receiverWalletId',
               'receiverCategoryId',
               'receiverTransactionId',
               'createdBy',
               'createdAt',
               'updatedAt',
               'deletedAt'
             ]
           );
    }

    // Read: any active member of the group, exactly like a group expense.
    function isGroupSettlementMember(data) {
      return isSignedIn()
        && request.auth.uid in groupSettlementGroup(data.groupId).memberIds;
    }

    // Create: the caller writes their own record, is one of the pair and both
    // sides are active members of the target group.
    function isGroupSettlementCreateTarget(data, group) {
      return data.createdBy == request.auth.uid
        && request.auth.uid in group.memberIds
        && data.fromUserId in group.memberIds
        && data.toUserId in group.memberIds;
    }

    // The creditor owns the linked income, so only they may clear the link and
    // only while both the stored and the new record are active. A debtor delete
    // with a linked movement is denied: the creditor must unlink first.
    function isGroupSettlementSoftDelete(previous, next) {
      return previous.deletedAt == null
        && next.deletedAt is string
        && isGroupSettlementLinkEmpty(next)
        && (
          previous.receiverTransactionId == null
          || request.auth.uid == previous.toUserId
        )
        && next.diff(previous).affectedKeys().hasOnly(
             request.auth.uid == previous.toUserId
               ? [
                   'deletedAt',
                   'updatedAt',
                   'receiverWalletId',
                   'receiverCategoryId',
                   'receiverTransactionId'
                 ]
               : ['deletedAt', 'updatedAt']
           );
    }

    // A regular edit keeps the record active. The receiver link keys may only
    // change for the creditor, and once an income exists the debtor can no
    // longer resize it (the service rejects it with AMOUNT_LOCKED).
    function isGroupSettlementEdit(previous, next) {
      return previous.deletedAt == null
        && next.deletedAt == null
        && (
          request.auth.uid == previous.toUserId
          || (
            next.receiverWalletId == previous.receiverWalletId
            && next.receiverCategoryId == previous.receiverCategoryId
            && next.receiverTransactionId == previous.receiverTransactionId
          )
        )
        && (
          request.auth.uid == previous.toUserId
          || previous.receiverTransactionId == null
          || next.amountCents == previous.amountCents
        );
    }

    match /groupExpenses/{expenseId} {
      allow get, list: if isGroupExpenseMember(resource.data);

      allow create: if isSignedIn()
        && isGroupExpenseCreateTarget(
             request.resource.data,
             groupExpenseGroup(request.resource.data.groupId)
           )
        && hasGroupExpenseMoney(request.resource.data)
        && hasGroupExpenseShares(request.resource.data)
        && hasGroupExpenseFields(request.resource.data)
        && hasGroupExpenseLinks(request.resource.data)
        && hasGroupExpenseLinkCoherence(request.resource.data)
        && hasGroupExpenseIdentity(request.resource.data)
        && request.resource.data.deletedAt == null;

      allow update: if isSignedIn()
        && isGroupExpenseUpdateTarget(
             resource.data,
             request.resource.data,
             groupExpenseGroup(resource.data.groupId)
           )
        && hasGroupExpenseMoney(request.resource.data)
        && hasGroupExpenseShares(request.resource.data)
        && hasGroupExpenseFields(request.resource.data)
        && hasGroupExpenseLinks(request.resource.data)
        && hasGroupExpenseIdentity(request.resource.data)
        && (
          isGroupExpenseSoftDelete(resource.data, request.resource.data)
          || isGroupExpenseLinkedSoftDelete(
               resource.data,
               request.resource.data
             )
          || (
            hasGroupExpenseLinkCoherence(request.resource.data)
            && isGroupExpenseEdit(resource.data, request.resource.data)
          )
        );

      allow delete: if false;
    }

    // Group settlements (TICKET-010 Phase B). Root collection with a `groupId`
    // field, like `groupExpenses`: the income movement is validated with one
    // `getAfter` on this known path plus one `get` on the group, and the
    // settlement id never builds a path from user input outside the service.
    //
    // Any member reads the group ledger; only the two pair members create, edit
    // or delete. Both sides may record a payment (the service derives the
    // direction), but only the creditor may link a wallet. The group, the pair,
    // the direction, the currency and the creation stamp are immutable and the
    // record is never hard-deleted.
    //
    // No composite index: `getGroupSettlementsOperation` filters only with
    // `where('groupId', '==', groupId)` and sorts client-side.
    match /groupSettlements/{settlementId} {
      allow get, list: if isGroupSettlementMember(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isGroupSettlementCreateTarget(
             request.resource.data,
             groupSettlementGroup(request.resource.data.groupId)
           )
        && hasGroupSettlementPair(request.resource.data)
        && hasGroupSettlementMoney(request.resource.data)
        && hasGroupSettlementFields(request.resource.data)
        && hasGroupSettlementLinkShape(request.resource.data)
        && request.resource.data.deletedAt == null
        // Only the creditor ever links the income, so a debtor create is always
        // social-only.
        && (
          request.resource.data.createdBy == request.resource.data.toUserId
          || isGroupSettlementLinkEmpty(request.resource.data)
        );

      allow update: if isGroupSettlementMember(resource.data)
        && resource.data.deletedAt == null
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.pairId == resource.data.pairId
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && hasGroupSettlementPair(request.resource.data)
        && hasGroupSettlementMoney(request.resource.data)
        && hasGroupSettlementFields(request.resource.data)
        && hasGroupSettlementLinkShape(request.resource.data)
        && request.resource.data.updatedAt is string
        && (
          isGroupSettlementSoftDelete(resource.data, request.resource.data)
          || isGroupSettlementEdit(resource.data, request.resource.data)
        );

      allow delete: if false;
    }

    // Group invitations use the deterministic id `groupId__inviteeId`, so one
    // document exists per pair and re-inviting reopens it. Only the owner writes
    // them and only accepted friends can be invited: the create validates the
    // owner-namespaced group id and the referenced friendship, while the group
    // update validates the owner again with `getAfter`.
    //
    // `list` is participant-only. The repository queries by `inviterId` (owner
    // list) or `inviteeId` (received list), each a single-field index that
    // proves one of the two branches; a `groupId`-only query would not.
    match /groupInvitations/{invitationId} {
      // A `get` on a missing invitation must resolve to not-found so an
      // idempotent invite can decide whether to create or reopen it. Same
      // deliberate existence-oracle trade-off as the friend pair documents.
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/groupInvitations/$(invitationId))
          || isGroupInvitationParticipant(resource.data)
        );

      allow list: if isGroupInvitationParticipant(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.inviterId == request.auth.uid
        && isOwnedGroupId(request.resource.data.groupId, request.auth.uid)
        && request.resource.data.status == 'pending'
        && invitationId == request.resource.data.groupId
             + '__' + request.resource.data.inviteeId
        && request.resource.data.inviteeId != request.auth.uid
        && isGroupInvitationPair(request.resource.data)
        && hasGroupInvitationFields(request.resource.data)
        && isFriendshipOf(
             get(/databases/$(database)/documents/friendships/$(request.resource.data.pairId)).data,
             request.resource.data.inviterId,
             request.resource.data.inviteeId
           );

      allow update: if isGroupInvitationParticipant(resource.data)
        && keepsGroupInvitationIdentity(resource.data, request.resource.data)
        && hasGroupInvitationFields(request.resource.data)
        && (
          isInviteeInvitationResponse(resource.data, request.resource.data)
          || isInviterInvitationCancel(resource.data, request.resource.data)
          || isInvitationRename(resource.data, request.resource.data)
          || isInvitationReopen(resource.data, request.resource.data)
        );

      allow delete: if false;
    }

    // ---- TICKET-061 join code projection and requests --------------------
    // `groupCodes/{code}` is a lookup projection: any signed-in user may `get`
    // one code, but `list` is denied so codes cannot be enumerated. Only the
    // owner creates it (with the group in the same batch) and only the group
    // name may be refreshed on rename.
    function hasGroupCodeFields(data) {
      return data.keys().hasOnly(['groupId', 'ownerId', 'groupName'])
        && isGroupText(data.groupId, 1500)
        && isGroupText(data.ownerId, 1500)
        && isGroupText(data.groupName, 60);
    }

    function isGroupCodeFor(group, codeData, code) {
      return group.ownerId == codeData.ownerId
        && group.name == codeData.groupName
        && group.joinCode == code;
    }

    match /groupCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && isGroupJoinCode(code)
        && hasGroupCodeFields(request.resource.data)
        && request.resource.data.ownerId == request.auth.uid
        && isGroupCodeFor(
             getAfter(
               /databases/$(database)/documents/groups/$(request.resource.data.groupId)
             ).data,
             request.resource.data,
             code
           );

      // Rename propagation only: group, owner and the code itself are frozen.
      // `getAfter` accepts the batch that renames the group and the projection
      // together and keeps the shared name from drifting.
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.groupId == resource.data.groupId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['groupName']
           )
        && isGroupText(request.resource.data.groupName, 60)
        && getAfter(
             /databases/$(database)/documents/groups/$(resource.data.groupId)
           ).data.name == request.resource.data.groupName
        && getAfter(
             /databases/$(database)/documents/groups/$(resource.data.groupId)
           ).data.joinCode == code;

      allow delete: if false;
    }

    // Join requests use the deterministic id `groupId__requesterId`, so one
    // document exists per pair. No `ownerId` is stored: the owner is proven
    // with a group read in the rules, and `list` is participant-only.
    //
    // No composite index: the owner queue filters only with
    // `where('groupId', '==', groupId)` and sorts client-side.
    function hasGroupJoinRequestFields(data) {
      return data.keys().hasOnly(
          [
            'groupId',
            'requesterId',
            'joinCode',
            'status',
            'createdAt',
            'updatedAt'
          ]
        )
        && isGroupText(data.groupId, 1500)
        && isGroupText(data.requesterId, 1500)
        && isGroupJoinCode(data.joinCode)
        && data.status == 'pending'
        && data.createdAt is string
        && data.updatedAt is string;
    }

    function isJoinRequestParticipant(data) {
      return isSignedIn()
        && (
          data.requesterId == request.auth.uid
          || get(
               /databases/$(database)/documents/groups/$(data.groupId)
             ).data.ownerId == request.auth.uid
        );
    }

    function isJoinRequestOwner(groupId) {
      return get(
        /databases/$(database)/documents/groups/$(groupId)
      ).data.ownerId == request.auth.uid;
    }

    function isJoinRequestForGroup(group, codeData, requestData) {
      return group.joinCode == requestData.joinCode
        && !(request.auth.uid in group.memberIds)
        && group.ownerId == codeData.ownerId
        && group.name == codeData.groupName
        && codeData.groupId == requestData.groupId;
    }

    function isJoinRequestStatusChange(previous, next) {
      return previous.status == 'pending'
        && next.status in ['accepted', 'rejected']
        && next.diff(previous).affectedKeys().hasOnly(['status', 'updatedAt'])
        && next.updatedAt is string
        && isJoinRequestOwner(previous.groupId);
    }

    // Acceptance must also prove the requester landed in `memberIds` with the
    // group update written in the same transaction.
    function acceptsJoinRequest(previous, next) {
      return next.status == 'accepted'
        && isJoinRequestStatusChange(previous, next)
        && previous.requesterId in getAfter(
             /databases/$(database)/documents/groups/$(previous.groupId)
           ).data.memberIds;
    }

    function rejectsJoinRequest(previous, next) {
      return next.status == 'rejected'
        && isJoinRequestStatusChange(previous, next);
    }

    match /groupJoinRequests/{requestId} {
      // A `get` on a missing request must resolve to not-found so a duplicate
      // create can decide; existing rows stay participant-only.
      allow get: if isSignedIn()
        && (
          !exists(
            /databases/$(database)/documents/groupJoinRequests/$(requestId)
          )
          || isJoinRequestParticipant(resource.data)
        );

      allow list: if isJoinRequestParticipant(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.requesterId == request.auth.uid
        && requestId == request.resource.data.groupId
             + '__' + request.resource.data.requesterId
        && hasGroupJoinRequestFields(request.resource.data)
        && isJoinRequestForGroup(
             getAfter(
               /databases/$(database)/documents/groups/$(request.resource.data.groupId)
             ).data,
             getAfter(
               /databases/$(database)/documents/groupCodes/$(request.resource.data.joinCode)
             ).data,
             request.resource.data
           );

      allow update: if isJoinRequestParticipant(resource.data)
        && (
          acceptsJoinRequest(resource.data, request.resource.data)
          || rejectsJoinRequest(resource.data, request.resource.data)
        );

      allow delete: if false;
    }

    // In-app notifications. The document id is the deterministic dedupe key, so a
    // retried event cannot duplicate it. The recipient lists and reads the inbox;
    // the actor writes it for the other participant and may `get` that single
    // deterministic document inside the settlement transaction (see the get
    // rule). Notifications are never deleted.
    //
    // State model: `seenAt` = first presented (drives the Pendientes/Vistas
    // segments), `readAt` = opened (drives the unread marker). Creation stores
    // both as null; opening writes both, a dismissed banner writes only
    // `seenAt`. Both stamps are append-only: they go from null to a string on
    // the owner's client and are never erased or rewritten, so a row cannot be
    // un-read nor moved from Vistas back to Pendientes.
    //
    // The reserved TICKET-047 types (`friend-request`, `friend-request-accepted`,
    // `group-expense`, `group-settlement`) are read-compatible on the client but
    // NOT writable yet: no producer exists. `isNotificationType` allows the
    // three settlement events, the TICKET-008 `group-invite` producer and the
    // three TICKET-061 join-code events.
    //
    // No composite index: `getNotificationsOperation`/`listenNotificationsOperation`
    // filter only with `where('userId', '==', uid)` and sort client-side.
    match /notifications/{notificationId} {
      // The actor needs a single `get` by its deterministic id to make the
      // settlement transaction (and the group-invite producer) idempotent; the
      // inbox `list` stays owner-only. A missing id must resolve to not-found
      // instead of permission-denied so the first write can decide whether to
      // create it. Same deliberate existence-oracle trade-off as the friend
      // pair documents.
      allow get: if isSignedIn()
        && (
          !exists(/databases/$(database)/documents/notifications/$(notificationId))
          || isNotificationOwner(resource.data)
          || isGroupSettlementNotificationActor(resource.data)
          || isSettlementNotificationActor(resource.data)
          || isGroupInviteNotificationActor(resource.data)
          || isGroupJoinNotificationActor(resource.data)
        );

      allow list: if isNotificationOwner(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid
        && notificationId == request.resource.data.dedupeKey
        && isNotificationType(request.resource.data.type)
        && request.resource.data.keys().hasOnly(
             ['userId', 'type', 'payload', 'createdAt', 'readAt', 'seenAt', 'dedupeKey']
           )
        && hasNotificationPayload(request.resource.data)
        && request.resource.data.readAt == null
        // Tolerant read: a TICKET-046 client that does not know `seenAt` can
        // still create its notification during a rolling deploy, and the mapper
        // treats the missing key exactly as null.
        && request.resource.data.get('seenAt', null) == null
        && request.resource.data.createdAt is string
        && (
          request.resource.data.type == 'group-invite'
            ? isGroupInviteNotificationTarget(request.resource.data)
            : (
                request.resource.data.type in
                  [
                    'group-join-request',
                    'group-join-accepted',
                    'group-join-rejected'
                  ]
                  ? isGroupJoinNotificationTarget(
                      request.resource.data,
                      notificationId
                    )
                  : (
                      request.resource.data.type == 'group-settlement'
                        ? isGroupSettlementNotificationTarget(
                            request.resource.data
                          )
                        : isNotificationTargetFor(
                            getAfter(
                              /databases/$(database)/documents/settlements/$(request.resource.data.payload.settlementId)
                            ).data,
                            request.resource.data
                          )
                    )
              )
        );

      // Owner-only and limited to the two stamps: `userId` and the payload are
      // immutable. A stamp that already has a value must keep it, and a null
      // stamp can only stay null or become a string, so the state is monotonic
      // (seen-only update on an unread row, or a full open, both accepted).
      // `get(key, null)` reads a pre-TICKET-047 document (key not stored) as
      // null, so a legacy row can still be stamped without any migration.
      allow update: if isNotificationOwner(resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['readAt', 'seenAt']
           )
        && (resource.data.get('readAt', null) != null
            ? request.resource.data.get('readAt', null)
                == resource.data.get('readAt', null)
            : (request.resource.data.get('readAt', null) == null
               || request.resource.data.get('readAt', null) is string))
        && (resource.data.get('seenAt', null) != null
            ? request.resource.data.get('seenAt', null)
                == resource.data.get('seenAt', null)
            : (request.resource.data.get('seenAt', null) == null
               || request.resource.data.get('seenAt', null) is string));

      allow delete: if false;
    }
  }
}
